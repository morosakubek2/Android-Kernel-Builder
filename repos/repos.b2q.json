[
  {
    "kernelSource": {
      "name": "android_kernel_samsung_sm8350",
      "repo": "https://github.com/morosakubek2/flip_3_android_kernel_samsung_sm8350",
      "branch": "Flip3-Android16",
      "device": "b2q",
      "defconfig": "gki_defconfig"
    },
    "withKernelSU": false,
    "withSUSFS": false,
    "withLXC": false,
    "toolchains": [
      {
        "name": "clang",
        "repo": "https://github.com/rsuntk/toolchains.git",
        "branch": "clang-11",
        "binPath": ["bin"]
      },
      {
        "name": "google",
        "repo": "https://github.com/rsuntk/toolchains.git",
        "branch": "androidcc-4.9",
        "binPath": ["bin"]
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang/bin/clang",
      "externalCommand": {
        "CROSS_COMPILE": "google/bin/arm-linux-androideabi-",
        "CROSS_COMPILE_ARM32": "google/bin/arm-linux-androideabi-",
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "LD": "ld.lld",
        "AR": "llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "READELF": "llvm-readelf",
        "STRIP": "llvm-strip",
        "LLVM_IAS": "1",
        "GCC_TOOLCHAIN": ""
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/morosakubek2/AnyKernel3",
      "branch": "b2q"
    }
  }
]
